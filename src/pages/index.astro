---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import LinkMuted from '../components/LinkMuted.astro';
---

<Layout title="Venticotto links">
	<main
		class=`
			flex
			flex-col
			gap-9
			items-center
			justify-center
			min-h-screen
			px-3
			py-5
			text-center
		`
	>
		<div class=`
			bg-white
			w-screen
			p-3
		`>
			<h1
				class=`
				inline-block
				font-extrabold
				leading-tight
				text-[clamp(2.25rem,_2vw_+_2rem,_4.25rem)]
				bg-gradient-to-r from-[#310CD6] to-[#D60C0F]
				text-transparent
				bg-clip-text
				uppercase
			`
			>
				Venticotto
			</h1>
		</div>
		<p class=`
				text-gray-100
				text-xl
			`>
			A quick, engaging card game of fun, luck, strategy and hidden&nbsp;depth!
		</p>
		<ul class=`
			flex
			flex-col
			gap-4
			max-w-80
			w-full
		`>
			<Link
				href="https://youtu.be/SJpmD7oz-EI"
				icon="youtube-color"
				label="Watch an overview"
			/>
			<Link
				href="https://drive.google.com/drive/folders/1JooLAZAfTbhu0szZ3tVWVwQueLDvQRUw?usp=sharing"
				icon="google-drive-color"
				label="View the Sell Sheet"
			/>
			<Link
				href="https://docs.google.com/document/d/1RLVBWbKVQBsA6xsd1SrwKaNX6a_j39glZ5fJfixpj0c/edit?usp=sharing"
				icon="google-docs-color"
				label="Read the rules"
			/>
			<Link
				href="https://screentop.gg/@stowball1/venticotto"
				icon="screentop"
				label="Play on Screentop.gg"
			/>
			<Link
				href="https://drive.google.com/drive/folders/133nfFfYg22oUpc9_0zBnrXxI8No74xk0?usp=sharing"
				icon="printer"
				label="Get the Print and Play"
			/>
			<LinkMuted
				href="mailto:matt@mattstow.com?subject=Venticotto"
				icon="email"
				label="Email me"
			/>
		</ul>
		<div class=`
			flex
			flex-col
			gap-4
			max-w-80
			w-full
		`>
			<h2 class="text-gray-100">You might also like:</h2>
			<ul class=`
				flex
				gap-4
			`>
				<LinkMuted href="https://push-up.mattstow.com" label="Push-Up!" />
				<LinkMuted
					href="https://not-so-fast.mattstow.com"
					label="Not So Fast"
				/>
			</ul>
		</div>
		<p class="text-gray-100">Designed by Matt Stow</p>
	</main>
</Layout>
